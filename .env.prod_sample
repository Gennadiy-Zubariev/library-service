# Django
DJANGO_SECRET_KEY=generate-a-long-random-key
DJANGO_SETTINGS_MODULE=config.settings.prod
# comma separated, no spaces, no http://
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# set to True only when the site is served over HTTPS
DJANGO_HTTPS=False
# True: Django serves /media/ itself (no nginx needed). False if a proxy/S3 serves it
DJANGO_SERVE_MEDIA=True

# PostgreSQL
POSTGRES_DB=library_db
POSTGRES_USER=library_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
